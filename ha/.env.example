# На боевом окружении обязательно замените пароль на свой
POSTGRES_DB=shortener
POSTGRES_USER=shortener
POSTGRES_PASSWORD=shortener

# Порт, на котором frontend (nginx) слушает на хосте.
# Локально удобно 3000, на боевом сервере — 80 (или 443, если настроен TLS).
FRONTEND_PORT=3000

# Лимит памяти Redis-кэша; вытеснение — allkeys-lru (НФТ №5), задаётся в docker-compose.yml
REDIS_MAXMEMORY=64mb

MAX_URL_LENGTH=2048
CODE_LENGTH=7
RATE_LIMIT_CREATE_PER_MINUTE=20
RATE_LIMIT_REDIRECT_PER_MINUTE=300
API_PREFIX=/api/v1
CORS_ORIGINS=*
