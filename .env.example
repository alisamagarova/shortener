# На боевой ВМ обязательно замените пароль на свой
POSTGRES_DB=shortener
POSTGRES_USER=shortener
POSTGRES_PASSWORD=shortener

DATABASE_URL=postgresql://shortener:shortener@db:5432/shortener

# Порт, на котором frontend (nginx) слушает на хосте.
# Локально удобно 3000, на боевой ВМ — 80 (или 443, если настроен TLS).
FRONTEND_PORT=3000

MAX_URL_LENGTH=2048
CODE_LENGTH=7
CACHE_MAX_SIZE=1000
RATE_LIMIT_CREATE_PER_MINUTE=20
RATE_LIMIT_REDIRECT_PER_MINUTE=300
API_PREFIX=/api/v1
CORS_ORIGINS=*
